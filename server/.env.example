MONGO_URI=mongodb://localhost:27017/hostel-maintenance
PORT=5000
DB_BACKUP_KEY=<long-random-backup-key>
GOOGLE_DRIVE_FOLDER_ID=<folder-id-in-a-shared-drive>
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=<base64-encoded-service-account-json>
VAPID_PUBLIC_KEY=<generated public key>
VAPID_PRIVATE_KEY=<generated private key>
VAPID_SUBJECT=mailto:<an email address you control>
CLOUDINARY_CLOUD_NAME=<cloud name>
CLOUDINARY_API_KEY=<API key>
CLOUDINARY_API_SECRET=<API secret>
TWILIO_ACCOUNT_SID=<Twilio account SID>
TWILIO_AUTH_TOKEN=<Twilio auth token>
TWILIO_PHONE_NUMBER=<Twilio sender number in E.164 format>
SMS_RECIPIENTS=<comma-separated E.164 phone numbers>
